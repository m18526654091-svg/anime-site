# AnimeHub Environment Configuration
# Copy this file to .env and update values for your deployment.

# Backend
# 运行环境：development / staging / production
ENVIRONMENT=development

# 数据库连接
#   开发（SQLite）：sqlite:///./animehub.db
#   生产（PostgreSQL 示例）：postgresql+psycopg2://animehub:STRONG_PASSWORD@127.0.0.1:5432/animehub
DATABASE_URL=sqlite:///./animehub.db

# Docker 部署：PostgreSQL 口令（必填、强随机；与 DATABASE_URL 中的口令保持一致）
# 生成：openssl rand -hex 16
POSTGRES_PASSWORD=

# JWT 签名密钥（必填，必须为强随机串，长度>=16；切勿使用示例/默认值）
# 生成命令：openssl rand -hex 32
# 后端会在使用空值或已知默认值时拒绝启动
SECRET_KEY=

# token 过期时间（分钟）当前由后端代码固定为 1 天（登录态有效期），暂未读取环境变量
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 允许的跨域来源（逗号分隔），生产环境必填，禁止使用 *
# 示例：ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
ALLOWED_ORIGINS=

# Docker 部署：你的公开域名（Caddy 会自动申请 HTTPS 证书）
# 示例：DOMAIN=your-domain.com
DOMAIN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000